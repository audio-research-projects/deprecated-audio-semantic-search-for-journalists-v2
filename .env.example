# OpenAI API key (required for the agent)
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-api-key

# Configuración de embeddings de ingesta. El pipeline genera
# EMBEDDINGS_CONFIG_PATH desde estas variables antes de procesar; no editar el TOML a mano.
# Valores permitidos, separados por coma: text, clap, gemini, embeddinggemma.
# Para Gemini multimodal usar: text,clap,gemini y definir GEMINI_API_KEY arriba.
# Para audio local con EmbeddingGemma 2: text,embeddinggemma (extra embeddinggemma).
EMBEDDINGS_ACTIVE=text,clap
# Clasificadores acústicos, separados por coma. YAMNet no genera embeddings:
# produce etiquetas AudioSet y sus scores por segmento.
CLASSIFIERS_ACTIVE=yamnet
EMBEDDINGS_CONFIG_PATH=./config/embeddings.toml
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLAP_EMBEDDING_MODEL=laion/clap-htsat-unfused
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_OUTPUT_DIMENSIONALITY=1536
EMBEDDINGGEMMA_MODEL=google/embeddinggemma-2
EMBEDDINGGEMMA_OUTPUT_DIMENSIONALITY=768
# EMBEDDINGGEMMA_DEVICE=cpu
# YAMNet requiere: uv sync --extra yamnet
YAMNET_MODEL=https://tfhub.dev/google/yamnet/1
YAMNET_TOP_K=5

# Dataset procesado que lee el agente, la API y las evaluaciones.
# Puede apuntar a una versión validada distinta de DATASET_OUTPUT.
# Dataset que se utiliza para producción
DATASET_PATH=./dataset

# Agent Runtime: release versionada en GCS descargada al disco efímero local.
# DATASET_GCS_URI=gs://your-audio-search-bucket/releases/2026-08-26
# DATASET_PATH=/tmp/audio-search-dataset/2026-08-26
# Tiempo máximo (segundos) para cada llamada del agente al search service remoto.
# Debe cubrir el cold start de Cloud Run; 180 s es el margen de producción.
SEARCH_SERVICE_TIMEOUT=180
# Sólo se devuelven segmentos cuya duración sea estrictamente mayor a este
# valor. El default de producción es 5 segundos.
MIN_SEGMENT_DURATION_SECONDS=0

# Directorio con los audios fuente a procesar (usado por src/simple_dataset_pipeline.py)
# Se puede sobrescribir con el flag --input
AUDIO_INPUT_DIR=./data/audio

# Directorio que escribe/regenera el pipeline (src/simple_dataset_pipeline.py).
# Puede ser una versión candidata; no cambia DATASET_PATH automáticamente.
# Se puede sobrescribir con el flag --output.
DATASET_OUTPUT=./dataset

# Clips de reproducción: un Opus por segmento en {DATASET_OUTPUT}/segment_clips.
# Contexto (s) que se agrega antes y después del segmento, para poder escuchar
# lo que rodea al hallazgo. Se puede sobrescribir con --clip-context / --clip-bitrate,
# o desactivar la generación con --no-segment-clips.
SEGMENT_CLIP_CONTEXT_SEC=5
SEGMENT_CLIP_BITRATE=32k

# Los clips no se descargan al runtime: se sirven desde el bucket con URLs
# firmadas. Por defecto se resuelven como {DATASET_GCS_URI}/segment_clips;
# definí SEGMENT_CLIPS_GCS_URI sólo si viven en otro prefijo o bucket.
# Sin DATASET_GCS_URI, se reproducen desde {DATASET_PATH}/segment_clips (dev local).
# SEGMENT_CLIPS_GCS_URI=gs://your-audio-search-bucket/releases/2026-08-26/segment_clips
SEGMENT_CLIP_URL_TTL_SECONDS=900

# OpenAI model to use
OPENAI_MODEL=gpt-4o-mini

# Idioma de las queries del agente (ISO 639-1). Si no es inglés, las queries
# pasadas a CLAP se traducen a inglés antes de generar el embedding, porque
# laion/clap-htsat-unfused usa un text encoder RoBERTa-base entrenado en inglés.
QUERY_LANGUAGE=es

# Traducción de consultas CLAP, EmbeddingGemma y YAMNet mediante Vercel AI Gateway.
# También admite VERCEL_OIDC_TOKEN en lugar de esta clave.
AI_GATEWAY_API_KEY=
TEXT_GENERATION_MODEL=openai/gpt-4o-mini

# Reformulación local de consultas con Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b

# Modalidad de retrieval del agente: text | audio | both
# Usar text/audio para comparar índices en evaluaciones separadas.
AGENT_MODALITY=both

# Evaluación RAG: elegir una única implementación para cada corrida.
# ragas requiere: uv sync --group eval
# deepeval requiere: uv sync --extra eval-deepeval
EVALUATION_FRAMEWORK=ragas
EVALUATION_JUDGE_MODEL=gpt-4o-mini
EVALUATION_JUDGE_TEMPERATURE=0

# Dataset de evaluación: manual (preguntas humanas), sintético (generado por RAGAS)
# o hybrid (unión de ambos, sin duplicados).
# manual:  usa EVALUATION_MANUAL_DATASET_PATH.
# synthetic: usa EVALUATION_SYNTHETIC_DATASET_PATH, creado con
#            evaluation/generate_synthetic_questions.py.
# hybrid:  combina EVALUATION_MANUAL_DATASET_PATH + EVALUATION_SYNTHETIC_DATASET_PATH
#          y escribe el resultado en EVALUATION_HYBRID_DATASET_PATH.
EVALUATION_DATASET_SOURCE=manual
EVALUATION_DATASET_SIZE=20
EVALUATION_DATASET_MAX_SEGMENTS=0
# Control de RAGAS TestsetGenerator: 1 worker es más estable en CPU/MPS.
EVALUATION_GENERATION_MAX_WORKERS=1
EVALUATION_GENERATION_TIMEOUT=1200
EVALUATION_GENERATION_LANGUAGE=es
EVALUATION_MANUAL_DATASET_PATH=./evaluation/test_datasets/ragas_eval_dataset_unlabeled.json
EVALUATION_SYNTHETIC_DATASET_PATH=./evaluation/test_datasets/synthetic/ragas_synthetic_questions.json
EVALUATION_HYBRID_DATASET_PATH=./evaluation/test_datasets/synthetic/ragas_hybrid_questions.json
# EVALUATION_DATASET_PATH puede sobrescribir cualquiera de los anteriores.

# Logging level
LOG_LEVEL=INFO

# Google Agent Platform / Agent Runtime (requerido para despliegue)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east1

# Opcional: bucket de artefactos y trazas del runtime
LOGS_BUCKET_NAME=your-agent-artifacts-bucket
