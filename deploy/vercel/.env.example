# ==========================================================================
# deploy/vercel — variables de entorno (local: .env.local, prod: Vercel env)
# ==========================================================================

# --------------------------------------------------------------------------
# OBLIGATORIAS
# --------------------------------------------------------------------------

# Neon PostgreSQL connection string (pgvector habilitado).
# Sin esta variable fallan /api/search, /api/datasets, /api/corpus, etc.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Modelo de texto servido por Vercel AI Gateway (Eve, planner y traducción).
# En Vercel se autentica automáticamente con OIDC; localmente usar `vercel env pull`.
TEXT_GENERATION_MODEL=openai/gpt-4o-mini

# --------------------------------------------------------------------------
# EMBEDDINGS DE CONSULTA (deben coincidir con lo publicado en Neon)
# --------------------------------------------------------------------------
# Cada provider genera embeddings por HTTP API (nada de PyTorch en Functions).
# Las dimensiones tienen que ser iguales a las columnas text_embedding /
# audio_embedding cargadas por scripts/publish_dataset_neon.py.
#
# Providers soportados: "huggingface" | "openai" | "gemini" | "custom" | "embeddinggemma"

# Indice de texto (default: HF Inference API, all-MiniLM-L6-v2, 384d)
TEXT_EMBEDDING_PROVIDER=huggingface
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_API_TOKEN=hf_your-token-here

# Índice de audio del corpus local: EmbeddingGemma 2, 768d.
# La API genera un embedding de la CONSULTA DE TEXTO para buscar ese audio.
AUDIO_EMBEDDING_PROVIDER=embeddinggemma
AUDIO_EMBEDDING_MODEL=google/embeddinggemma-2
EMBEDDINGGEMMA_OUTPUT_DIMENSIONALITY=768

# Requerida para el paquete de pesos incluido en la función Python de Vercel.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Alternativa para datasets procesados con Gemini (no mezclar espacios):
# AUDIO_EMBEDDING_PROVIDER=gemini
# AUDIO_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_OUTPUT_DIMENSIONALITY=1536

# Provider "custom": endpoint HTTP propio (p. ej. servicio CLAP en Cloud Run)
# que expone POST /embed con body { text, modality } y responde { embedding }.
# CUSTOM_EMBEDDING_API_URL=https://clap-inference.example.com

# El servicio privado `embeddings` se configura en vercel.ts. Su binding
# inyecta EMBEDDINGGEMMA_SERVICE_URL automáticamente en api y eve.
# No definir esa variable manualmente. Para desarrollo o un servicio externo,
# se puede sobrescribir la URL con EMBEDDINGGEMMA_API_URL.
# EMBEDDINGGEMMA_API_URL=https://embeddinggemma-2-xxx.run.app

# --------------------------------------------------------------------------
# OPCIONALES
# --------------------------------------------------------------------------

# Las consultas de audio (CLAP/Gemma) y YAMNet se traducen al inglés con el Gateway.

# Idioma de las queries; "en" saltea la traduccion (default: es)
QUERY_LANGUAGE=es

# Duracion minima estricta de segmento en segundos (default: 0)
MIN_SEGMENT_DURATION_SECONDS=0

# Dataset por defecto cuando el request no trae dataset_id (default: el
# dataset con is_default=true, o el mas reciente)
# DEFAULT_DATASET_ID=default

# Auth del canal Eve (/eve/v1/*). Si se define, exige
# "Authorization: Bearer <token>". Sin definir, el canal queda publico
# (principal anonimo) — ver agent/channels/eve.ts.
# EVE_PUBLIC_BEARER_TOKEN=

# CORS para la API directa (/api/*). Lista separada por comas, o "*".
# Solo hace falta si un frontend en OTRO origen (p. ej. el
# frontend-direct-search en GitHub Pages) consume esta API. Sin definir,
# no se emiten headers CORS (ver src/cors.ts).
# ALLOWED_ORIGINS=https://your-org.github.io

# Credenciales OIDC + ID del store privado; Vercel los inyecta al runtime.
# Para publicar desde local, `vercel env pull` al entorno conectado.
# BLOB_STORE_ID=store_xxxxxxxx
# VERCEL_OIDC_TOKEN=...
# Alternativamente, token RW de Vercel Blob (largo plazo; evitar si OIDC sirve).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Frontend: base URL de la API. Vacio = mismo origen (default). Completar
# solo si la SPA se sirve desde otro dominio.
# VITE_API_BASE_URL=
