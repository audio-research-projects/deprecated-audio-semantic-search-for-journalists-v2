# Variables de terminal para desplegar en GCP. Copiar a deploy.env y reemplazar valores.
# No guardar credenciales ni API keys en este archivo.
PROJECT_ID=mi-proyecto-gcp
REGION=us-east1
AGENT_SERVICE_ACCOUNT=audio-search-agent@mi-proyecto-gcp.iam.gserviceaccount.com
PROXY_SERVICE_ACCOUNT=audio-search-proxy@mi-proyecto-gcp.iam.gserviceaccount.com
SEARCH_SERVICE_ACCOUNT=audio-search-service@mi-proyecto-gcp.iam.gserviceaccount.com
OPENAI_SECRET=audio-search-openai-api-key
ARTIFACT_REPOSITORY=agents-agui-proxies
PROXY_SERVICE=audio-search-copilotkit-proxy
# Origins de GitHub Pages para CORS, separados por coma (sin ruta ni barra final).
WIDGET_ORIGIN=https://your-github-org.github.io
SEARCH_SERVICE=audio-search-service
DATASET_BUCKET=mi-proyecto-gcp-audio-search-datasets
DATASET_RELEASE=2026-08-26-mi-release
# El dataset lo descarga el search service; DATASET_PATH debe permanecer bajo /tmp.
DATASET_GCS_URI=gs://mi-proyecto-gcp-audio-search-datasets/releases/2026-08-26-mi-release
DATASET_RUNTIME_PATH=/tmp/audio-search-dataset/2026-08-26-mi-release
# Duración mínima estricta para incluir un segmento en los resultados.
MIN_SEGMENT_DURATION_SECONDS=0
# CLAP y YAMNet consultan espacios/etiquetas en inglés. El search service usa
# OPENAI_SECRET para traducir cuando QUERY_LANGUAGE no es inglés.
QUERY_LANGUAGE=es
# URL del search service desplegado; la consume el agente (agents-cli deploy).
SEARCH_SERVICE_URL=https://audio-search-service-XXXX.a.run.app
